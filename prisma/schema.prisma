// ============================================================
// Prisma Schema — PT. Hartindo Surya Medika
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Pooler (runtime)
  directUrl = env("DIRECT_URL")     // Direct (migrate/push)
}

// ============================================================
// KATALOG
// ============================================================

model Manufacturer {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  logoUrl    String?    // URL logo manufakturer
  desc       String?    // Deskripsi singkat
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("manufacturers")
}

model Category {
  id             String        @id @default(cuid()) // e.g. CAT-SPINAL
  slug           String        @unique
  name           String
  desc           String?
  sortOrder      Int           @default(0)
  imageUrl       String?       // URL gambar untuk card kategori di publik
  manufacturerId Int?          // Relasi ke manufakturer
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  products       CategoryToProduct[]
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("categories")
}

model Product {
  id               String   @id // e.g. "MRT-0002"
  slug             String   @unique
  name             String
  description      String?
  productKind      String?  // 'implant' | 'instrument'
  materialDisplay  String?  // 'SS' | 'Ti'
  tableType        String?  // 'SIZE_CATALOG' | 'COMPONENT_LIST'
  showTable        Boolean  @default(true)
  showInfoBlock    Boolean  @default(false)
  showBrand        Boolean  @default(true)
  isActive         Boolean  @default(true)
  imageUrl         String?
  
  categories       CategoryToProduct[]
  implantSpecs     ImplantSpec[]
  components       ProductComponent[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("products")
}

model CategoryToProduct {
  productId    String
  categoryId   String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fixationType String?  // 'locking' | 'non_locking' | 'standard'
  sortOrder    Int      @default(0)

  @@id([productId, categoryId])
  @@map("category_to_product")
}

model ImplantSpec {
  id                Int      @id @default(autoincrement())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder         Int      @default(0)
  catalogNumber     String?  // source_catalog_number
  material          String?  // source_material
  size              String?
  tkdn              String?
  eCatalog          String?
  isVisible         Boolean  @default(true)

  @@map("implant_specs")
}

model ProductComponent {
  id                Int      @id @default(autoincrement())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder         Int      @default(0)
  productNumber     String?
  catalogNumber     String?
  componentName     String
  specification     String?
  qty               String?
  isVisible         Boolean  @default(true)

  @@map("product_components")
}

// ============================================================
// KONTAK / PESAN MASUK
// ============================================================

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  institusi String?
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ============================================================
// ADMIN / PENGELOLA (CUSTOM AUTH)
// ============================================================

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}
